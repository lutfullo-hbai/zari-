# Ollama (localhost — network_mode: host)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Groq API (cloud LLM — llm_provider "groq" bo'lsa ishlatiladi)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# LLM provayder: "groq" | "ollama"
LLM_PROVIDER=groq

# Ma'lumotlar bazasi (localhost — network_mode: host)
DATABASE_URL=postgresql://zari:zari@localhost:5434/zari
REDIS_URL=redis://localhost:6380/0

# Ovoz
WAKE_WORD=jarvis
TTS_VOICE=uz-UZ-MadinaNeural
AUDIO_INPUT_DEVICE=4
AUDIO_OUTPUT_DEVICE=0
AUDIO_OUTPUT_SAMPLE_RATE=48000
ENABLE_TRANSLATION=false
WHISPER_LANGUAGE=uz

# Xabarlar
TELEGRAM_TOKEN=
EMAIL_ADDRESS=

# N8n
N8N_URL=http://localhost:5678
N8N_API_KEY=
N8N_TEMPLATES_API_URL=http://localhost:8000

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=json
