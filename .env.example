# LLM provayder: "ollama" (local, tavsiya) | "groq" (cloud, tez)
LLM_PROVIDER=ollama

# Ollama (lokal LLM) — docker compose up db redis ollama bilan
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Groq API (cloud fallback — llm_provider "groq" bo'lsa kerak)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Agent Brain — murakkab ko'p intentli so'rovlarda LLM reja tuzadi
ENABLE_BRAIN=true

# Ma'lumotlar bazasi (docker-compose port 5433 → 5432 map qiladi)
DATABASE_URL=postgresql://zari:zari@localhost:5433/zari
REDIS_URL=redis://localhost:6379/0

# Ovoz
WAKE_WORD=jarvis
WAKE_THRESHOLD=0.5
# openwakeword tayyor modellari: jarvis, alexa, heymedia...
# "zari" uchun custom model treningi kerak: https://github.com/dscripka/openWakeWord
WAKE_WORD_MODELS=
TTS_VOICE=uz-UZ-MadinaNeural
TTS_ENGINE=edge # edge | piper
PIPER_MODEL_PATH=
PIPER_VOICE=en_US-lessac-medium
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
AUDIO_OUTPUT_SAMPLE_RATE=48000

# UZ<->EN tarjima (har xabarga +2 LLM chaqiruv) — odatda false tavsiya etiladi
ENABLE_TRANSLATION=false
WHISPER_LANGUAGE=uz

# Xabarlar (keyingi milestone lar uchun)
TELEGRAM_TOKEN=
EMAIL_ADDRESS=

# SMTP (for EmailSkill)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SENDER_ADDRESS=
DEFAULT_RECIPIENT=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Search backend: auto | perplexica | duckduckgo
SEARCH_BACKEND=auto
PERPLEXICA_URL=

# Web UI
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Bo'sh = auth yo'q (faqat local). LAN/server'da majburiy to'ldiring.
WEB_API_KEY=

# N8n
N8N_URL=http://localhost:5678
N8N_API_KEY=
N8N_WORKFLOWS_DIR=
