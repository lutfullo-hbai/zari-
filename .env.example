# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Ma'lumotlar bazasi
DATABASE_URL=postgresql://zari:zari@localhost:5432/zari
REDIS_URL=redis://localhost:6379/0

# Ovoz
WAKE_WORD=jarvis
WAKE_THRESHOLD=0.5
WAKE_WORD_MODELS=
TTS_VOICE=uz-UZ-MadinaNeural
TTS_ENGINE=edge # edge | piper
PIPER_MODEL_PATH=
PIPER_VOICE=en_US-lessac-medium
AUDIO_INPUT_DEVICE=4
AUDIO_OUTPUT_DEVICE=0
AUDIO_OUTPUT_SAMPLE_RATE=48000
ENABLE_TRANSLATION=true
WHISPER_LANGUAGE=uz

# Xabarlar (keyingi milestone lar uchun)
TELEGRAM_TOKEN=
EMAIL_ADDRESS=

# SMTP (for EmailSkill)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SENDER_ADDRESS=
DEFAULT_RECIPIENT=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Search backend
SEARCH_BACKEND=auto
PERPLEXICA_URL=

# N8N workflow templates
N8N_WORKFLOWS_DIR=
