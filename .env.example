# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Ma'lumotlar bazasi
DATABASE_URL=postgresql://zari:zari@localhost:5432/zari
REDIS_URL=redis://localhost:6379/0

# Ovoz
WAKE_WORD=zari
TTS_VOICE=uz-UZ-MadinaNeural
AUDIO_INPUT_DEVICE=4
AUDIO_OUTPUT_DEVICE=0
AUDIO_OUTPUT_SAMPLE_RATE=48000
ENABLE_TRANSLATION=true
WHISPER_LANGUAGE=uz

# Xabarlar (keyingi milestone lar uchun)
TELEGRAM_TOKEN=
EMAIL_ADDRESS=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
